{
    "manifest_version": 3,
    "name": "CopyEmail",
    "version": "1.3.0",
    "description": "Easily copy your account email from Google, Microsoft, and other websites where selecting it is difficult.",
    "icons": {
        "16": "app/icons/icon16.png",
        "32": "app/icons/icon32.png",
        "48": "app/icons/icon48.png",
        "128": "app/icons/icon128.png"
    },
    "permissions": [
        "clipboardWrite",
        "storage"
    ],
    "options_page": "app/options.html",
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*",
                "file:///*"
            ],
            "js": [
                "app/settings.js",
                "app/patterns.js",
                "app/geography.js",
                "app/scanner.js",
                "app/services.js",
                "app/content.js",
                "app/bootstrap.js"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "app/data/cities.txt"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_popup": "app/popup.html",
        "default_title": "CopyEmail"
    }
}
