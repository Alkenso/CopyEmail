{
    "name": "copyemail",
    "version": "1.0.0",
    "private": true,
    "description": "Copy visible email addresses with a subtle inline button.",
    "scripts": {
        "test": "playwright test",
        "check": "node -e \"const fs=require('node:fs'),cp=require('node:child_process');for(const file of fs.readdirSync('extension/app').filter(f=>f.endsWith('.js')))cp.execFileSync(process.execPath,['--check','extension/app/'+file],{stdio:'inherit'});\""
    },
    "devDependencies": {
        "@playwright/test": "1.64.1"
    }
}
